# --- Telegram (required) ---
# Token generated by @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (see the docs). The only authorized user.
ALLOWED_TELEGRAM_USER_ID=

# --- Language ---
# Language of everything you read (replies, /help, notices): en | pt
BOT_LANGUAGE=en

# --- LLM (optional) ---
# anthropic | openai_compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Only used with openai_compatible (e.g. http://localhost:11434/v1)
LLM_BASE_URL=
LLM_MODEL_ROUTER=
LLM_MODEL_HEAVY=
# Model for messages with images; empty = LLM_MODEL_ROUTER (it must accept images)
LLM_MODEL_VISION=
LLM_DAILY_BUDGET_USD=1.0
LLM_MONTHLY_BUDGET_USD=20.0
# With anthropic, if the models are empty: claude-haiku-5-5 (fast) and claude-opus-5-5 (heavy).
# Reasoning effort (e.g. low) for OpenAI reasoning models; empty = not sent
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Retries on 429/5xx/timeouts, with exponential backoff (Retry-After is honoured)
LLM_MAX_RETRIES=3
# Optional fallback LLM, used when the main one still fails after the retries
# (provider: anthropic or openai_compatible; key defaults to LLM_API_KEY for the same provider)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Routines/goals that failed because the LLM was unreachable are retried every N minutes
LLM_RETRY_MINUTES=10
# Recent messages sent as context
LLM_HISTORY_MESSAGES=10
# Prices in US$ per 1M tokens [input, output]. Anthropic models are already in the table.
# Format (illustrative values, check your provider's price table):
# LLM_PRICES={"gpt-5.4-mini": [0.25, 2.0], "gpt-5.5": [1.25, 10.0]}
LLM_PRICES={}
# Price used for models missing from the table (pessimistic on purpose)
LLM_DEFAULT_PRICE_INPUT=5.0
LLM_DEFAULT_PRICE_OUTPUT=25.0

# --- OpenAI Decisions (typed answers: probability, choice, score) ---
# Empty = uses LLM_API_KEY when the main provider is OpenAI itself
DECISIONS_API_KEY=
DECISIONS_BASE_URL=
DECISIONS_MODEL=gpt-6-luna
# US$ per 1M input tokens (output is free)
DECISIONS_PRICE_INPUT=0.10

# --- Audio (transcription by OpenAI) ---
# Empty = uses LLM_API_KEY when the main provider is OpenAI itself
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
# gpt-4o-mini-transcribe (~US$ 0.003/min), gpt-transcribe (~0.0045/min), whisper-1 (~0.006/min)
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_FALLBACK_MODEL=whisper-1
# Language you speak in voice messages (a hint for the transcription)
TRANSCRIBE_LANGUAGE=pt
# US$ per minute; empty = the built-in table for the model
TRANSCRIBE_PRICE_PER_MINUTE=

# --- Search ---
# auto = Anthropic's own web search when the provider is anthropic; otherwise wikipedia+duckduckgo
# Options: auto | anthropic | wikipedia | duckduckgo | wikipedia+duckduckgo
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=5
WIKIPEDIA_LANG=pt
# Links: text kept per page (web_fetch); bare links in your message are read before the
# LLM answers (at most LINK_AUTOFETCH_MAX); false turns that off
WEB_FETCH_MAX_CHARS=12000
LINK_AUTOFETCH=true
LINK_AUTOFETCH_MAX=2

# --- Proactive mode (optional) ---
PROACTIVE_DAILY_BUDGET_USD=0.5
# Minimum interval between goal runs, in minutes (0 turns the loop off)
PROACTIVE_INTERVAL_MINUTES=15
# How often (minutes) beat checks for due goals
PROACTIVE_POLL_MINUTES=5
# Goals may ask self-coding for new commands (with all of /feature's safeguards)
PROACTIVE_ALLOW_SELFCODE=true
# Initiatives: messages sent on its own (research on your interests, reminders,
# follow-up questions). Toggle at runtime with /proactive on|off
PROACTIVE_MESSAGES_ENABLED=true
PROACTIVE_MAX_MESSAGES_PER_DAY=8
PROACTIVE_MIN_GAP_MINUTES=60
# Each "anything worth sending?" costs an LLM call: ask at most every N min
PROACTIVE_DECIDE_EVERY_MINUTES=40
# After N hours without an initiative, it can't choose "nothing"
PROACTIVE_FORCE_AFTER_HOURS=3
# Quiet hours (local time): no goals and no initiatives
PROACTIVE_QUIET_START_HOUR=23
PROACTIVE_QUIET_END_HOUR=8
# Limits per goal run
PROACTIVE_MAX_STEPS=3
PROACTIVE_MAX_TOKENS_PER_RUN=30000
# Notify on Telegram when tasks and goal runs finish (false = silent goals)
PROACTIVE_NOTIFY=true
# Recurring goals: after 3 runs with the same result the interval doubles, up to this
GOAL_MAX_INTERVAL_HOURS=48

# --- Background tasks (Celery + Redis) ---
# Inside docker compose REDIS_URL is set automatically
REDIS_URL=redis://redis:6379/0
TASK_MAX_RETRIES=3
TASK_TIME_LIMIT_SECONDS=600
TASKS_TTL_DAYS=30
# After each message the bot is "busy" for N seconds (the proactive loop waits)
BUSY_AFTER_MESSAGE_SECONDS=120

# --- Short-term memory (Redis; see docs/memoria-curto-prazo.md) ---
STM_TTL_HOURS=12
STM_MAX_TURNS=30
STM_MAX_REFS=15
# A session idle for this many hours is dropped (the conversation log keeps everything)
STM_PROMOTE_IDLE_HOURS=3

# --- Background review (memory, skills, profile) ---
# Reviewed after REVIEW_EVERY_TURNS new messages, or REVIEW_MIN_TURNS and this many idle minutes
REVIEW_IDLE_MINUTES=10
REVIEW_MIN_TURNS=4
REVIEW_EVERY_TURNS=8
# off | on (one short line when something was kept) | verbose
REVIEW_NOTIFY=on

# --- Routines ---
# A routine failing with the same error alerts once, then reminds every N hours
ROUTINE_FAILURE_REMIND_HOURS=6

# --- Telegram quality of life ---
# Reactions on your message: 👀 received, 👍 done, 👎 error (when no placeholder was shown)
TELEGRAM_REACTIONS=true
# Messages sent in a row wait this long of quiet (ms) and become one turn; long pastes,
# forwards and albums wait a bit more (up to 7.5 s). 0 turns batching off.
INBOUND_DEBOUNCE_MS=300
# Documents (PDF, DOCX, TXT, MD, CSV, JSON): size limit, text kept, text sent with the message
DOCUMENT_MAX_MB=10
DOCUMENT_MAX_CHARS=60000
DOCUMENT_CONTEXT_CHARS=8000
# Voice replies: off | voice_in (reply to voice notes with voice) | always (OpenAI TTS, counted in the budget)
VOICE_REPLIES=off
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Key for TTS; empty = TRANSCRIBE_API_KEY, or LLM_API_KEY when the LLM is OpenAI itself
TTS_API_KEY=
TTS_PRICE_PER_1K_CHARS=0.015
# Plugins and skills unused for this many days leave /help and the prompt (still callable)
PLUGIN_STALE_DAYS=30

# --- Memory (Mongo) ---
# Most important items that go into the prompt ("working memory")
MEMORY_WORKING_SIZE=20
# Days without use for recency to drop by half
MEMORY_HALF_LIFE_DAYS=30
# Daily cleanup: archives items scoring below this and unused for N days
MEMORY_ARCHIVE_SCORE=0.05
MEMORY_ARCHIVE_AFTER_DAYS=90
# Local hour of the daily cleanup
MEMORY_MAINTENANCE_HOUR=4

# --- Personality and self-editing ---
# Repository the bot may edit (mounted at /repo in Docker)
REPO_PATH=
# Personality file; empty = <repository>/data/soul.md
SOUL_PATH=
# User profile, always in the prompt; empty = <repository>/data/profile.md
PROFILE_PATH=
# Size caps (characters) of the always-loaded files. Self-edits that would go over
# are refused; /profile consolidate shrinks the profile (keeping a full copy).
PROFILE_MAX_CHARS=4000
SOUL_MAX_CHARS=3000
# Self-coding (/feature): its own daily budget, outside LLM_DAILY_BUDGET_USD
SELFCODE_DAILY_BUDGET_USD=2.0
SELFCODE_MAX_ATTEMPTS=3
SELFCODE_TEST_TIMEOUT_SECONDS=300
SELFCODE_TIME_LIMIT_SECONDS=1800
# Projects (/project): Claude Code creates NEW projects (never touches the bot) in the
# "projects" container, in a new folder inside PROJECTS_HOST_PATH.
PROJECTS_ENABLED=true
# Folder on your PC where projects show up (default: uva-projects next to this repository)
PROJECTS_HOST_PATH=../uva-projects
# Claude Code credential (one of the two). Subscription: run `claude setup-token` on your
# PC and paste the token here. Or an Anthropic API key (billed separately).
CLAUDE_CODE_OAUTH_TOKEN=
PROJECTS_ANTHROPIC_API_KEY=
# Claude Code model (empty = its default)
PROJECT_CLAUDE_MODEL=
# Limits per project and per day
PROJECT_TIMEOUT_MINUTES=30
PROJECT_MAX_TURNS=80
PROJECT_MAX_BUDGET_USD=3.0
PROJECT_DAILY_BUDGET_USD=10.0
# /sh and /py: UVA's own folder, /uva, in an isolated container ("shell")
SHELL_ENABLED=true
# Maximum time per command, in seconds
SHELL_TIMEOUT_SECONDS=60
# Container limits
SHELL_MEMORY=1g
SHELL_CPUS=1
# true cuts /uva's internet access (then pip/curl don't work)
SHELL_NO_INTERNET=false
# MCP: tools from MCP servers (data/mcp.json), run by the isolated "mcp" gateway
# container. Its secrets go in mcp.env (see mcp.env.example), never here.
MCP_ENABLED=true
# Shared secret between the bot and the gateway (any long random string; required)
MCP_GATEWAY_TOKEN=
# Above this many MCP tools the prompt lists servers instead of tools
MCP_PROMPT_TOOL_LIMIT=30
# Gateway container limits; true cuts the remote servers' internet access
MCP_MEMORY=1g
MCP_CPUS=1
MCP_NO_INTERNET=false
# Local dashboard: http://localhost:8080 (this computer only)
DASHBOARD_PORT=8080
# Optional dashboard password (any user name). Empty = no password
DASHBOARD_PASSWORD=
# Author of the commits the bot makes in its own repository
GIT_AUTHOR_NAME=kundlatsch
GIT_AUTHOR_EMAIL=gustavo.kundlatsch@gmail.com

# --- Storage ---
# Inside docker compose, the Mongo host is "mongo"
MONGO_URI=mongodb://mongo:27017/uva
# SQLite (structured data, e.g. expenses). In Docker it lives in the sqlite-data volume.
SQLITE_PATH=/data/sqlite/uva.db
# Second brain (Markdown notes). In Docker, the folder on your PC mounted in the container:
# default ./brain inside the repository. E.g. SECOND_BRAIN_HOST_PATH=D:/Obsidian/UVA
SECOND_BRAIN_HOST_PATH=./brain
# Path inside the container (only change it when running outside Docker)
SECOND_BRAIN_PATH=/data/second-brain

# --- Fallback tier 2: similarity with commands (0-100) ---
# Above EXECUTE it runs right away; above CONFIRM it asks "did you mean...?"
SIMILARITY_EXECUTE_THRESHOLD=90
SIMILARITY_CONFIRM_THRESHOLD=75

# --- Logs ---
LOG_LEVEL=INFO
# Days events stay in Mongo (/log)
EVENTS_TTL_DAYS=90
# Time zone used for "today", "month" and displayed times
TIMEZONE=America/Sao_Paulo
