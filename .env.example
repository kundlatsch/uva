# --- Telegram (obrigatório) ---
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Seu user id numérico do Telegram (veja o README). Único usuário autorizado.
ALLOWED_TELEGRAM_USER_ID=

# --- LLM (opcional nesta fase) ---
# anthropic | openai_compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Só usado com openai_compatible (ex.: http://localhost:11434/v1)
LLM_BASE_URL=
LLM_MODEL_ROUTER=
LLM_MODEL_HEAVY=
# Modelo para mensagens com imagem; vazio = LLM_MODEL_ROUTER (precisa aceitar imagens)
LLM_MODEL_VISION=
LLM_DAILY_BUDGET_USD=1.0
LLM_MONTHLY_BUDGET_USD=20.0
# Com anthropic, se os modelos ficarem vazios: claude-haiku-5-5 (rápido) e claude-opus-5-5 (pesado).
# Esforço de raciocínio (ex.: low) para modelos de raciocínio da OpenAI; vazio = não envia
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Mensagens recentes enviadas como contexto
LLM_HISTORY_MESSAGES=10
# Preços em US$ por 1M de tokens [entrada, saída]. Modelos Anthropic já vêm na tabela.
# Formato (valores ilustrativos, confira a tabela de preços do provedor):
# LLM_PRICES={"gpt-5.4-mini": [0.25, 2.0], "gpt-5.5": [1.25, 10.0]}
LLM_PRICES={}
# Preço usado para modelos fora da tabela (pessimista de propósito)
LLM_DEFAULT_PRICE_INPUT=5.0
LLM_DEFAULT_PRICE_OUTPUT=25.0

# --- OpenAI Decisions (respostas tipadas: probabilidade, escolha, nota) ---
# Vazio = usa LLM_API_KEY quando o provedor principal é a própria OpenAI
DECISIONS_API_KEY=
DECISIONS_BASE_URL=
DECISIONS_MODEL=gpt-6-luna
# US$ por 1M tokens de entrada (saída é grátis)
DECISIONS_PRICE_INPUT=0.10

# --- Áudio (transcrição pela OpenAI) ---
# Vazio = usa LLM_API_KEY quando o provedor principal é a própria OpenAI
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
# gpt-4o-mini-transcribe (~US$ 0,003/min), gpt-transcribe (~0,0045/min), whisper-1 (~0,006/min)
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_FALLBACK_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=pt
# US$ por minuto; vazio = tabela embutida para o modelo
TRANSCRIBE_PRICE_PER_MINUTE=

# --- Pesquisa ---
# auto = busca da própria Anthropic quando o provedor é anthropic; senão wikipedia+duckduckgo
# Opções: auto | anthropic | wikipedia | duckduckgo | wikipedia+duckduckgo
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=5
WIKIPEDIA_LANG=pt

# --- Proatividade (opcional) ---
PROACTIVE_DAILY_BUDGET_USD=0.5
# Intervalo mínimo entre execuções de objetivos, em minutos (0 desliga o loop)
PROACTIVE_INTERVAL_MINUTES=15
# De quantos em quantos minutos o beat verifica se há objetivo vencido
PROACTIVE_POLL_MINUTES=5
# Objetivos podem pedir comandos novos ao auto-código (com todas as travas do /feature)
PROACTIVE_ALLOW_SELFCODE=true
# Iniciativas: mensagens por conta própria (pesquisas sobre seus interesses, lembretes,
# perguntas de acompanhamento). Liga/desliga em tempo real com /proativo on|off
PROACTIVE_MESSAGES_ENABLED=true
PROACTIVE_MAX_MESSAGES_PER_DAY=4
PROACTIVE_MIN_GAP_MINUTES=120
# Horário de silêncio (hora local): nada de objetivos nem iniciativas
PROACTIVE_QUIET_START_HOUR=23
PROACTIVE_QUIET_END_HOUR=8
# Limites por execução de um objetivo
PROACTIVE_MAX_STEPS=3
PROACTIVE_MAX_TOKENS_PER_RUN=30000
# Avisar no Telegram quando tarefas e execuções de objetivos terminam (false = objetivos silenciosos)
PROACTIVE_NOTIFY=true

# --- Tarefas em segundo plano (Celery + Redis) ---
# Dentro do docker compose o REDIS_URL é definido automaticamente
REDIS_URL=redis://redis:6379/0
TASK_MAX_RETRIES=3
TASK_TIME_LIMIT_SECONDS=600
TASKS_TTL_DAYS=30
# Depois de cada mensagem o bot fica "ocupado" por N segundos (o loop proativo espera)
BUSY_AFTER_MESSAGE_SECONDS=120

# --- Memória de curto prazo (Redis; ver docs/memoria-curto-prazo.md) ---
STM_TTL_HOURS=12
STM_MAX_TURNS=30
STM_MAX_REFS=15
# Sessão parada há tantas horas é revisada (vai para a memória longa) e descartada
STM_PROMOTE_IDLE_HOURS=3

# --- Memória (Mongo) ---
# Itens mais importantes que vão no prompt ("memória de trabalho")
MEMORY_WORKING_SIZE=20
# Dias sem uso para a recência cair pela metade
MEMORY_HALF_LIFE_DAYS=30
# Limpeza diária: arquiva itens com nota abaixo disso e sem uso há N dias
MEMORY_ARCHIVE_SCORE=0.05
MEMORY_ARCHIVE_AFTER_DAYS=90
# Hora local da limpeza diária
MEMORY_MAINTENANCE_HOUR=4

# --- Personalidade e auto-edição ---
# Repositório que o bot pode editar (no Docker é montado em /repo)
REPO_PATH=
# Arquivo de personalidade; vazio = <repositório>/data/soul.md
SOUL_PATH=
# Auto-código (/feature): orçamento diário próprio, fora do LLM_DAILY_BUDGET_USD
SELFCODE_DAILY_BUDGET_USD=2.0
SELFCODE_MAX_ATTEMPTS=3
SELFCODE_TEST_TIMEOUT_SECONDS=300
SELFCODE_TIME_LIMIT_SECONDS=1800
# Autor dos commits que o bot faz no próprio repositório
GIT_AUTHOR_NAME=kundlatsch
GIT_AUTHOR_EMAIL=gustavo.kundlatsch@gmail.com

# --- Armazenamento ---
# Dentro do docker compose, o host do Mongo é "mongo"
MONGO_URI=mongodb://mongo:27017/uva
# SQLite (dados estruturados, ex.: gastos). No Docker fica no volume sqlite-data.
SQLITE_PATH=/data/sqlite/uva.db
# Second brain (notas Markdown). No Docker, a pasta do PC montada no container:
# padrão ./brain dentro do repositório. Ex.: SECOND_BRAIN_HOST_PATH=D:/Obsidian/UVA
SECOND_BRAIN_HOST_PATH=./brain
# Caminho dentro do container (só mude se rodar fora do Docker)
SECOND_BRAIN_PATH=/data/second-brain

# --- Fallback 2: similaridade com comandos (0-100) ---
# Acima de EXECUTE roda direto; acima de CONFIRM pergunta "Você quis dizer...?"
SIMILARITY_EXECUTE_THRESHOLD=90
SIMILARITY_CONFIRM_THRESHOLD=75

# --- Logs ---
LOG_LEVEL=INFO
# Dias que os eventos ficam no Mongo (/log)
EVENTS_TTL_DAYS=90
# Fuso usado para "hoje", "mês" e horários exibidos
TIMEZONE=America/Sao_Paulo
