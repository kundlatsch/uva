# --- Telegram (obrigatório) ---
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Seu user id numérico do Telegram (veja o README). Único usuário autorizado.
ALLOWED_TELEGRAM_USER_ID=

# --- LLM (opcional nesta fase) ---
# anthropic | openai_compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Só usado com openai_compatible (ex.: http://localhost:11434/v1)
LLM_BASE_URL=
LLM_MODEL_ROUTER=
LLM_MODEL_HEAVY=
LLM_DAILY_BUDGET_USD=1.0
LLM_MONTHLY_BUDGET_USD=20.0

# --- Proatividade (opcional) ---
PROACTIVE_DAILY_BUDGET_USD=0.5
PROACTIVE_INTERVAL_MINUTES=60

# --- Armazenamento ---
# Dentro do docker compose, o host do Mongo é "mongo"
MONGO_URI=mongodb://mongo:27017/uva
# Caminho do "second brain" (pasta de notas)
SECOND_BRAIN_PATH=/data/second-brain

# --- Logs ---
LOG_LEVEL=INFO
